# Claude API (RAG cevap üretimi için)
ANTHROPIC_API_KEY=

# htr-kraken-server (self-hosted, Kraken)
KRAKEN_MODEL_DIR=./mcp-servers/htr-server/models
KRAKEN_DEFAULT_MODEL=ottoman_print_base.mlmodel

# transkribus-mcp-server (@lazyants/transkribus-mcp-server, Transkribus'un
# herkese açık modelleri için - https://readcoop.eu hesabınızın bilgileri)
TRANSKRIBUS_USER=
TRANSKRIBUS_PASSWORD=

# Herkese açık Transkribus model ID'leri (htrId) - hesap gerektirir, model
# kendisi indirilemez, sadece Transkribus API'si üzerinden çağrılır.
# El yazması (manuscript) için varsayılan: "Ottoman Fatwa Manuscripts", CER %5.94
TRANSKRIBUS_HTR_ID_MANUSCRIPT=169801
# Basılı/matbu metin için varsayılan: "OttomanTurkish_Print_1", CER %7.2
TRANSKRIBUS_HTR_ID_PRINT=52502

# Osmanlica.com (KAPALI/TİCARİ servis, açık kaynak değil - opsiyonel 3. backend
# olarak eklenebilir; ücretsiz katman günlük 10 kredi ile sınırlı)
# OSMANLICA_COM_API_KEY=
